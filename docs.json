{
  "$schema": "https://mintlify.com/schema.json",
  "name": "Masterpiece Labs",
  "theme": "luma",
  "logo": {
    "light": "/images/image(13).png",
    "dark": "/images/image(13).png"
  },
  "favicon": {
    "light": "/images/Masterpiece_fav_icon.png",
    "dark": "/images/Masterpiece_fav_icon.png"
  },
  "colors": {
    "primary": "#2c3576",
    "light": "#ffffff",
    "dark": "#2c3576"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Open dashboard",
      "href": "https://masterpiecelabs.xyz"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Borrowers",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "introduction",
              "quickstart",
              "how-financing-works"
            ]
          },
          {
            "group": "Apply for Financing",
            "pages": [
              "apply/business-profile",
              "apply/invoice-details",
              "apply/loan-request",
              "apply/supporting-documents",
              "apply/business-verification",
              "apply/application-status"
            ]
          },
          {
            "group": "After Approval",
            "pages": [
              "after-approval/overview",
              "after-approval/loan-agreement",
              "after-approval/daca-setup",
              "after-approval/notice-of-exclusive-control",
              "after-approval/proof-of-remittance"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "reference/faq"
            ]
          }
        ]
      },
      {
        "tab": "Stakers",
        "groups": [
          {
            "group": "Stakers",
            "pages": [
              "stakers/coming-soon"
            ]
          }
        ]
      }
    ]
